[
  {kernel, [
    {error_logger, silent},
    %% Suppress all logging below 'critical' to keep benchmark output clean.
    %% This silences shackle reconnect warnings, enif fd-stealing errors, and
    %% other internal noise that is expected and harmless in the test context.
    {logger_level, critical},
    {logger, [
      {handler, default, logger_std_h, #{
        level  => critical,
        config => #{type => standard_error}
      }}
    ]}
  ]},

  {sasl, [
    {sasl_error_logger, false},
    {errlog_type,       error}
  ]}
].